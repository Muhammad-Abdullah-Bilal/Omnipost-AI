# Root .gitignore for OmniPost AI

# Security: Never commit environment files with API keys!
**/.env
**/.env.local
**/.env.*.local
*.env

# Dependencies & Environments
**/node_modules/
**/.venv/
**/venv/

# Next.js build output & caches
**/.next/
**/out/
**/.swc/

# Python cache & build files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/

# Local databases & logs
**/*.db
**/*.sqlite3
posts_local.db
backend/posts_local.db
*.log
npm-debug.log*
yarn-debug.log*

# OS specific files
.DS_Store
Thumbs.db
